# NIYAM Frontend Environment Configuration
# Copy this file to .env or .env.local to customize for your local development setup.

# Base API URL for backend communication:
# - For Android Emulator: http://10.0.2.2:5000 (default fallback if omitted)
# - For iOS Simulator / Web: http://localhost:5000 (default fallback if omitted)
# - For Physical Device (same Wi-Fi): http://<YOUR_DEVELOPMENT_MACHINE_LAN_IP>:5000 (e.g., http://192.168.1.100:5000)
EXPO_PUBLIC_API_URL=http://localhost:5000
